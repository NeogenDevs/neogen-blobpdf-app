{
    "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
    "type": "app",
    "name": "Azure Blob SAS Downloader",
    "id": "neogen-blobpdf-app",
    "backend": true,
    "executable": "neogen-blobpdf-app",
    "info": {
        "description": "Generate short-lived SAS download links for PDF blobs based on an input id.",
        "author": {
            "name": "Neogen"
        },
        "keywords": [
            "azure",
            "blob",
            "sas"
        ],
        "logos": {
            "small": "img/logo.svg",
            "large": "img/logo.svg"
        },
        "version": "0.1.0",
        "updated": "2026-02-19"
    },
    "includes": [
        {
            "type": "page",
            "name": "Download PDF",
            "path": "/a/neogen-blobpdf-app/download",
            "addToNav": true,
            "defaultNav": true,
            "role": "Viewer"
        }
    ],
    "dependencies": {
        "grafanaDependency": ">=10.0.0",
        "plugins": []
    },
    "buildMode": "production"
}